# Set default behavior to automatically normalize line endings
* text=auto

# Python & Web Source Files
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Shell & Scripts
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Configuration Files
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.cfg text eol=lf

# Binary Assets (Prevent line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.sqlite3 binary
*.woff binary
*.woff2 binary

